{
  "permissions": {
    "allow": [
      "Edit(src/**)",
      "Edit(tests/**)",
      "Edit(docs/**)",
      "Edit(plans/**)",
      "Edit(README.md)",
      "Edit(CONTRIBUTING.md)",
      "Edit(pyproject.toml)",
      "Edit(uv.lock)",
      "Write(src/**)",
      "Write(tests/**)",
      "Write(docs/**)",
      "Write(plans/**)",
      "Write(README.md)",
      "Write(CONTRIBUTING.md)",
      "Write(pyproject.toml)",
      "Write(uv.lock)",
      "Bash(uv run*)",
      "Bash(uv sync*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(git branch*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(mkdir*)",
      "Bash(ln -sf*)",
      "Bash(find*)",
      "Bash(grep*)",
      "Bash(ls*)",
      "Bash(echo*)",
      "Bash(touch*)"
    ],
    "deny": [
      "Bash(cat *.env*)",
      "Bash(cat *.envrc*)",
      "Bash(git push*)",
      "Bash(pip install*)",
      "Bash(python -m pip*)"
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  }
}
